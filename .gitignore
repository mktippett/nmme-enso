# Raw CSV dumps (usually large)
# *.csv   # comment out if CSVs are small reference files that should be tracked

# Plots (regenerable; commit selectively)
# plots/  # uncomment to exclude all plots from git

# Copyrighted journal PDFs — cite in README instead (DOI), never commit
papers/*.pdf

# Beamer build output (regenerable from tex/slides.tex)
tex/*.pdf

# Disk cache for expensive climatology/scaling computations (config.py) —
# regenerable, keyed on store fingerprints, not source of truth.
cache/

